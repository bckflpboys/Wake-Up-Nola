{
    "cli": {
        "version": ">= 12.0.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "https://pulse-app.ticketafrica.shop/api"
            },
            "ios": {
                "simulator": true
            }
        },
        "production": {
            "env": {
                "EXPO_PUBLIC_API_URL": "https://pulse-app.ticketafrica.shop/api"
            }
        }
    },
    "submit": {
        "production": {}
    }
}